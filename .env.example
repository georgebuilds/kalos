# Server
PORT=3000

# LLM Provider
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
LLM_API_KEY=
LLM_BASE_URL=
# LLM_BASE_URL is required for ollama (e.g. http://localhost:11434/api)
# and optional override for other providers

# GitHub App
GITHUB_APP_ID=
# Path to the PEM file written by the setup wizard (preferred, chmod 600)
GITHUB_APP_PRIVATE_KEY_PATH=kalos.pem
# Alternative: inline escaped key (legacy, less secure)
# GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Worker
# MAX_CONCURRENT_TASKS defaults to 1. Increase for team/org deployments.
WORKER_POLL_INTERVAL_MS=2000
# MAX_CONCURRENT_TASKS=1
TASK_TIMEOUT_MS=600000

# CI follow-through: max attempts to fix a failing CI check (0 to disable)
CI_FIX_MAX_ATTEMPTS=3

# Executor
# EXECUTOR=process  # default: run agent as a local child process (no Docker required)
# EXECUTOR=docker   # run agent inside an ephemeral Docker container (requires Docker daemon)
EXECUTOR=process

# Docker (only used when EXECUTOR=docker)
DOCKER_SOCKET=/var/run/docker.sock
AGENT_IMAGE=kalos-agent:latest

# Database
DATABASE_URL=kalos.db
