{
  "name": "kalos",
  "version": "0.2.2",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @kalos/orchestrator run dev",
    "dev:orchestrator": "npm --workspace @kalos/orchestrator run dev",
    "dev:agent": "npm --workspace @kalos/agent run dev",
    "typecheck": "npm --workspace @kalos/shared run typecheck && npm --workspace @kalos/orchestrator run typecheck && npm --workspace @kalos/agent run typecheck",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
